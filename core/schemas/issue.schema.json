{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delivery-system:schema:issue:0.1",
  "title": "Delivery System Issue",
  "allOf": [
    { "$ref": "artifact.schema.json" },
    {
      "type": "object",
      "required": ["background", "goal", "scope", "nonGoals", "constraints", "dependencies", "acceptanceCriteria", "verification", "definitionOfDone"],
      "properties": {
        "type": { "const": "issue" },
        "background": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "definitionOfDone": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  ]
}
