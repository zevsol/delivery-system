{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delivery-system:schema:artifact:0.1",
  "title": "Delivery System Artifact",
  "type": "object",
  "required": ["id", "type", "title", "status", "owner", "source", "relationships"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$" },
    "type": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "proposed", "approved", "active", "blocked", "deferred", "superseded", "completed", "closed"] },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "targetId"],
        "properties": {
          "relation": { "enum": ["covers", "dependsOn", "blocks", "supersedes", "implements", "verifies", "relatesTo"] },
          "targetId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "baseline": { "type": "string" },
    "decisionRecord": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "changeHistory": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
