{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delivery-system:schema:change-request:0.1",
  "title": "Delivery System Change Request",
  "allOf": [
    { "$ref": "artifact.schema.json" },
    {
      "type": "object",
      "required": ["requestText", "trigger", "changeType", "affectedArtifacts", "impact", "options", "recommendation", "userDecision", "effectiveBaseline"],
      "properties": {
        "type": { "const": "change-request" },
        "requestText": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "changeType": { "enum": ["clarification", "defect", "new-feature", "scope-expansion", "architecture-change", "technical-discovery", "urgent-blocker"] },
        "affectedArtifacts": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" } },
        "recommendation": { "type": "string", "minLength": 1 },
        "userDecision": { "enum": ["accept", "reject", "defer", "need-clarification", "pending"] },
        "effectiveBaseline": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
